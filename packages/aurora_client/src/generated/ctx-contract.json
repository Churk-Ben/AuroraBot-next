{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "StateId": {
      "type": "string",
      "format": "aurora-id"
    },
    "Location": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "StateAddress": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": ["id", "location"],
      "additionalProperties": false
    },
    "GetRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": ["key"],
      "additionalProperties": false
    },
    "ListRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SetRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    "DeleteRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": ["key"],
      "additionalProperties": false
    },
    "WatchRequest": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "GetResponse": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "ListResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateAddress"
          }
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "SetResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "null"
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "DeleteResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean"
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": ["error"],
      "additionalProperties": false
    },
    "StateChange": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StateId"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": ["set", "delete"]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "previous": {
          "$ref": "#/$defs/JsonValue"
        },
        "existed": {
          "type": "boolean"
        }
      },
      "required": ["id", "location", "revision", "action", "value", "previous", "existed"],
      "additionalProperties": false
    },
    "WatchReady": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "WatchEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "const": "org.aurora.core:events/ctx/changed"
        },
        "data": {
          "$ref": "#/$defs/StateChange"
        }
      },
      "required": ["type", "event", "data"],
      "additionalProperties": false
    },
    "WatchError": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": ["type", "error"],
      "additionalProperties": false
    },
    "WatchMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/WatchReady"
        },
        {
          "$ref": "#/$defs/WatchEvent"
        },
        {
          "$ref": "#/$defs/WatchError"
        }
      ]
    }
  },
  "http": {
    "get": {
      "method": "POST",
      "path": "/ctx/get",
      "operation": "org.aurora.core:operations/ctx/get",
      "request": {
        "$ref": "#/$defs/GetRequest"
      },
      "response": {
        "$ref": "#/$defs/GetResponse"
      },
      "error": {
        "$ref": "#/$defs/ErrorResponse"
      }
    },
    "list": {
      "method": "POST",
      "path": "/ctx/list",
      "operation": "org.aurora.core:operations/ctx/list",
      "request": {
        "$ref": "#/$defs/ListRequest"
      },
      "response": {
        "$ref": "#/$defs/ListResponse"
      },
      "error": {
        "$ref": "#/$defs/ErrorResponse"
      }
    },
    "set": {
      "method": "POST",
      "path": "/ctx/set",
      "operation": "org.aurora.core:operations/ctx/set",
      "request": {
        "$ref": "#/$defs/SetRequest"
      },
      "response": {
        "$ref": "#/$defs/SetResponse"
      },
      "error": {
        "$ref": "#/$defs/ErrorResponse"
      }
    },
    "delete": {
      "method": "POST",
      "path": "/ctx/delete",
      "operation": "org.aurora.core:operations/ctx/delete",
      "request": {
        "$ref": "#/$defs/DeleteRequest"
      },
      "response": {
        "$ref": "#/$defs/DeleteResponse"
      },
      "error": {
        "$ref": "#/$defs/ErrorResponse"
      }
    }
  },
  "watch": {
    "path": "/ctx/watch",
    "subscribe": "org.aurora.core:operations/ctx/subscribe",
    "unsubscribe": "org.aurora.core:operations/ctx/unsubscribe",
    "event": "org.aurora.core:events/ctx/changed",
    "request": {
      "$ref": "#/$defs/WatchRequest"
    },
    "message": {
      "$ref": "#/$defs/WatchMessage"
    },
    "subscription": "one_per_connection",
    "unsubscribe_by": "close_connection",
    "revision_scope": "host_context",
    "replay": false,
    "reconnect": "resubscribe_then_refresh"
  }
}
