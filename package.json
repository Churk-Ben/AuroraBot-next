{
  "name": "aurorabot-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bot": "uv run --locked python scripts/bot.py",
    "panel": "uv run --locked python scripts/panel.py",
    "tui": "uv run --locked python scripts/tui.py",
    "check": "node scripts/check.ts",
    "typecheck": "pnpm typecheck:python && pnpm typecheck:typescript",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint && pnpm lint:style",
    "lint:oxlint": "oxlint -c oxlint.config.ts --deny-warnings .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:style": "stylelint \"{apps,packages}/**/*.{css,scss,vue,html}\" --allow-empty-input --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck:typescript": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "typecheck:python": "pyright --project pyproject.toml"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "pyright": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
